// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                        String   @id @default(uuid())
  clerkId                   String   @unique
  associationName           String
  associationCode           String   @unique
  firstDelegateFullName     String
  firstDelegatePhoneNumber  String
  firstDelegateEmail        String
  secondDelegateFullName    String
  secondDelegatePhoneNumber String
  secondDelegateEmail       String
  thirdDelegateFullName     String
  thirdDelegatePhoneNumber  String
  thirdDelegateEmail        String
  createdAt                 DateTime @default(now())
  updateAt                  DateTime @updatedAt
}

model Member {
  id                        String   @id @default(uuid())
  clerkId                   String
  firstName                 String
  lastAndMiddleNames        String
  // middleName String
  dateOfBirth               String
  countryOfResidence        String   @map("countryOfBirth")
  memberMatriculationNumber String
  delegateRecommendation    String
  memberStatus              String
  nameOfBeneficiary         String
  associationName           String
  associationCode           String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  nameChangeRequests        NameChangeRequest[]
  memberTransferRequests    MemberTransferRequest[]

  @@unique([firstName, lastAndMiddleNames, dateOfBirth, delegateRecommendation])
}

model RemovedMember {
  id                        String    @id @default(uuid())
  originalMemberId          String?
  clerkId                   String
  firstName                 String
  lastAndMiddleNames        String
  dateOfBirth               String
  countryOfResidence        String    @map("countryOfBirth")
  memberMatriculationNumber String
  registrationDate          String
  associationName           String?
  associationCode           String
  nameOfBeneficiary         String?
  delegateRecommendation    String?
  memberStatus              String?
  reasonForLeaving          String
  originalMemberCreatedAt   DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model DeceasedMember {
  id                        String                   @id @default(uuid())
  clerkId                   String
  firstName                 String
  lastAndMiddleNames        String
  countryOfResidence        String   @map("countryOfBirth")
  memberMatriculationNumber String
  registrationDate          String
  nameOfBeneficiary         String
  associationName           String
  associationCode           String?
  dateOfDeath               String
  placeOfDeath              String
  contributionStatus        String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  documents                 DeceasedMemberDocument[]
}

model DeceasedMemberDocument {
  id               String         @id @default(uuid())
  deceasedMemberId String
  clerkId          String
  associationCode  String?
  documentType     String
  fileName         String
  mimeType         String
  fileSize         Int
  fileData         Bytes
  status           String         @default("submitted")
  rejectionReason  String?
  deceasedMember   DeceasedMember @relation(fields: [deceasedMemberId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([deceasedMemberId, documentType])
  @@index([deceasedMemberId])
  @@index([associationCode])
  @@index([clerkId])
  @@index([status])
}

model NameChangeRequest {
  id                          String   @id @default(uuid())
  memberId                    String
  clerkId                     String
  associationCode             String
  currentFirstName            String
  currentLastAndMiddleNames   String
  requestedFirstName          String
  requestedLastAndMiddleNames String
  reason                      String
  documentRequired            Boolean  @default(false)
  fileName                    String?
  mimeType                    String?
  fileSize                    Int?
  fileData                    Bytes?
  status                      String   @default("submitted")
  rejectionReason             String?
  reviewedBy                  String?
  reviewedAt                  DateTime?
  member                      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([memberId])
  @@index([clerkId])
  @@index([associationCode])
  @@index([status])
  @@index([createdAt])
}

model MemberTransferRequest {
  id                        String   @id @default(uuid())
  memberId                  String
  initiatingClerkId         String
  initiatingAssociationCode String
  receivingClerkId          String
  receivingAssociationCode  String
  currentFirstName          String
  currentLastAndMiddleNames String
  memberMatriculationNumber String
  status                    String   @default("receiving_delegate_pending")
  rejectionReason           String?
  receivingReviewedBy       String?
  receivingReviewedAt       DateTime?
  adminReviewedBy           String?
  adminReviewedAt           DateTime?
  member                    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([memberId])
  @@index([initiatingClerkId])
  @@index([receivingClerkId])
  @@index([initiatingAssociationCode])
  @@index([receivingAssociationCode])
  @@index([status])
  @@index([createdAt])
}

model AssociationContributionPayment {
  id              String    @id @default(uuid())
  associationCode String    @unique
  amountSent      Decimal   @db.Decimal(10, 2)
  amountVerified  Decimal   @default(0) @db.Decimal(10, 2)
  lastSubmittedAt DateTime?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([associationCode])
  @@index([lastSubmittedAt])
}

model AssociationContributionAssessment {
  id                    String                                   @id @default(uuid())
  totalAmount           Decimal                                  @db.Decimal(10, 2)
  totalVestedMembers    Int
  amountPerVestedMember Decimal                                  @db.Decimal(10, 2)
  dueDate               DateTime?
  createdAt             DateTime                                 @default(now())
  updatedAt             DateTime                                 @updatedAt
  groups                AssociationContributionAssessmentGroup[]
}

model AssociationContributionAssessmentGroup {
  id                 String                            @id @default(uuid())
  assessmentId       String
  associationCode    String
  vestedMembersCount Int
  amountOwed         Decimal                           @db.Decimal(10, 2)
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt
  assessment         AssociationContributionAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, associationCode])
  @@index([associationCode])
}

model AssociationContributionUsage {
  id              String   @id @default(uuid())
  associationCode String   @unique
  amountUsed      Decimal  @default(0) @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([associationCode])
}

model AssociationContributionCredit {
  id                        String   @id @default(uuid())
  associationCode           String
  memberMatriculationNumber String   @unique
  amountCredited            Decimal  @default(20) @db.Decimal(10, 2)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([associationCode])
}

model AssociationRegistrationUsage {
  id                        String   @id @default(uuid())
  associationCode           String
  memberMatriculationNumber String   @unique
  amountUsed                Decimal  @default(20) @db.Decimal(10, 2)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([associationCode])
}

model AssociationBalanceAdjustment {
  id              String   @id @default(uuid())
  associationCode String
  balanceType     String
  amount          Decimal  @default(0) @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([associationCode, balanceType])
  @@index([associationCode])
  @@index([balanceType])
}

model AssociationRegistrationPayment {
  id              String    @id @default(uuid())
  associationCode String    @unique
  amountSent      Decimal   @db.Decimal(10, 2)
  amountVerified  Decimal   @default(0) @db.Decimal(10, 2)
  lastSubmittedAt DateTime?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([associationCode])
  @@index([lastSubmittedAt])
}

model AssociationPaymentLedgerEntry {
  id              String   @id @default(uuid())
  associationCode String
  paymentType     String
  eventType       String
  amount          Decimal  @db.Decimal(10, 2)
  note            String?
  createdBy       String?
  createdAt       DateTime @default(now())

  @@index([associationCode])
  @@index([paymentType])
  @@index([eventType])
  @@index([createdAt])
}

model PaymentAlertReset {
  id        String   @id @default(uuid())
  alertType String   @unique
  resetAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
